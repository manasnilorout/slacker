{
  "name": "@manasnilorout/slacker",
  "version": "0.1.0",
  "description": "Local MCP server that talks to Slack as you, using slack-cli credentials",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manasnilorout/slacker.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/manasnilorout/slacker/issues"
  },
  "homepage": "https://github.com/manasnilorout/slacker#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "slacker": "dist/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
